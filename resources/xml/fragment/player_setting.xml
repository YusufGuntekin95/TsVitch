<brls:Box
        width="auto"
        height="auto"
        justifyContent="flexEnd"
        backgroundColor="@theme/brls/backdrop">

    <brls:Box
            id="player/cancel"
            height="100%"
            hideClickAnimation="true"
            grow="1"/>

    <brls:Box
            width="460"
            height="100%"
            axis="column"
            backgroundColor="@theme/color/nx_sidebar">

        <brls:Label
                height="26"
                margin="20"
                fontSize="24"
                text="Oynatma Ayarları"
                textColor="#ffffff"/>

        <ButtonClose
                id="button/close"
                focusable="true"
                positionType="absolute"
                positionTop="10"
                positionRight="10"/>

        <brls:ScrollingFrame
                id="player/settings"
                width="100%"
                grow="1"
                scrollingBehavior="centered">

            <brls:Box
                    width="auto"
                    height="auto"
                    axis="column"
                    paddingLeft="40"
                    paddingRight="@style/brls/tab_frame/content_padding_sides"
                    paddingBottom="@style/brls/tab_frame/content_padding_top_bottom"
                    alignItems="stretch">

                <brls:Header
                        width="auto"
                        height="auto"
                        title="Genel"
                        marginBottom="0px"/>
                <brls:Box
                        width="100%"
                        height="auto"
                        axis="column"
                        marginBottom="24px">
                    <brls:DetailCell id="setting/sleep"/>
                    <brls:BooleanCell id="setting/fullscreen"/>
                    <SelectorCell id="setting/onTopMode"/>
                    <brls:BooleanCell id="setting/video/mirror"/>
                </brls:Box>

                <brls:Header
                        width="auto"
                        height="auto"
                        title="Ses ve Altyazı"
                        marginBottom="0px"/>
                <brls:Box
                        width="100%"
                        height="auto"
                        axis="column"
                        marginBottom="24px">
                    <brls:DetailCell id="setting/track/subtitle"/>
                    <brls:DetailCell id="setting/track/audio"/>
                </brls:Box>

                <brls:Header
                        id="setting/video/custom/header"
                        visibility="gone"
                        width="auto"
                        height="auto"
                        marginBottom="0px"/>
                <brls:Box
                        id="setting/video/custom/box"
                        visibility="gone"
                        width="100%"
                        height="auto"
                        axis="column"
                        marginBottom="30px">
                    <SelectorCell
                            id="setting/video/custom/aspect"
                            visibility="gone"/>
                    <brls:BooleanCell
                            id="setting/video/custom/clip"
                            visibility="gone"/>
                    <brls:InputNumericCell
                            id="setting/video/custom/clip/start"
                            visibility="gone"/>
                    <brls:InputNumericCell
                            id="setting/video/custom/clip/end"
                            visibility="gone"/>
                </brls:Box>

                <brls:Header
                        width="auto"
                        height="auto"
                        title="Görüntü"
                        marginBottom="0px"/>
                <brls:Box
                        width="100%"
                        height="auto"
                        axis="column"
                        marginBottom="30px">
                    <brls:SliderCell id="setting/equalizer/brightness"/>
                    <brls:SliderCell id="setting/equalizer/contrast"/>
                    <brls:SliderCell id="setting/equalizer/saturation"/>
                    <brls:SliderCell id="setting/equalizer/gamma"/>
                    <brls:SliderCell id="setting/equalizer/hue"/>
                    <brls:RadioCell
                            id="setting/equalizer/reset"
                            title="Sıfırla"/>
                </brls:Box>
            </brls:Box>

        </brls:ScrollingFrame>

    </brls:Box>

</brls:Box>