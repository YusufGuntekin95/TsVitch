<brls:Box
        axis="column"
        width="100%"
        height="100%"
        paddingLeft="34"
        paddingRight="34"
        paddingTop="24"
        backgroundColor="@theme/color/nx_background">

    <brls:Box
            width="100%"
            height="112"
            marginBottom="18"
            paddingLeft="24"
            paddingRight="24"
            alignItems="center"
            backgroundColor="@theme/color/nx_surface"
            cornerRadius="22">
        <brls:Box axis="column" grow="1">
            <brls:Label
                    text="İNDİRİLENLER"
                    fontSize="28"
                    textColor="#ffffff"/>
            <brls:Label
                    text="İnternet olmadan izlemek için kaydettiğin film ve bölümler"
                    marginTop="6"
                    fontSize="14"
                    textColor="@theme/font/grey"/>
        </brls:Box>
        <brls:Label
                text="ÇEVRİMDIŞI"
                fontSize="12"
                textColor="@theme/color/nx_accent"/>
    </brls:Box>

    <RecyclingGrid
            id="home/downloads/recyclingGrid"
            grow="1"
            spanCount="1"
            itemHeight="100"
            paddingTop="8"
            paddingBottom="18"/>
</brls:Box>
