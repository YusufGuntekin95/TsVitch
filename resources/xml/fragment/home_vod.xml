<brls:Box
        axis="column"
        width="100%"
        height="100%"
        paddingLeft="34"
        paddingRight="30"
        paddingTop="24"
        backgroundColor="@theme/color/nx_background">

    <brls:Box
            width="100%"
            height="176"
            paddingLeft="26"
            paddingRight="22"
            paddingTop="22"
            paddingBottom="20"
            marginBottom="22"
            backgroundColor="@theme/color/nx_surface"
            cornerRadius="22">
        <brls:Box axis="column" grow="1" justifyContent="center">
            <brls:Label
                    text="NX MEDIA  •  FİLMLER"
                    fontSize="13"
                    textColor="@theme/color/nx_accent"/>
            <brls:Label
                    text="Sineman burada."
                    marginTop="7"
                    fontSize="34"
                    textColor="#ffffff"/>
            <brls:Label
                    text="Filmini seç, anında izle veya çevrimdışı izlemek için Switch'e indir."
                    marginTop="8"
                    width="650"
                    fontSize="15"
                    textColor="@theme/font/grey"/>
            <brls:Box marginTop="16" height="28" alignItems="center">
                <brls:Label text="A  Oynat" fontSize="13" textColor="#ffffff"/>
                <brls:Label text="R  İndir" marginLeft="24" fontSize="13" textColor="@theme/color/nx_accent"/>
                <brls:Label text="Y  Yenile" marginLeft="24" fontSize="13" textColor="@theme/font/grey"/>
            </brls:Box>
        </brls:Box>

        <brls:Box
                width="210"
                height="44"
                paddingLeft="16"
                paddingRight="16"
                backgroundColor="@theme/color/nx_background"
                cornerRadius="22"
                alignItems="center"
                justifyContent="center">
            <brls:Label
                    id="nx/vod/status"
                    text="Film arşivi yükleniyor…"
                    fontSize="13"
                    textColor="@theme/font/grey"/>
        </brls:Box>
    </brls:Box>

    <brls:Box width="100%" height="44" alignItems="center">
        <brls:Label
                text="Tüm Filmler"
                fontSize="22"
                textColor="#ffffff"/>
        <brls:Label
                text="Poster seçerek ayrıntılara geç"
                marginLeft="14"
                fontSize="13"
                textColor="@theme/font/grey"/>
    </brls:Box>

    <RecyclingGrid
            id="nx/vod/grid"
            grow="1"
            width="100%"
            spanCount="@style/tsvitch/grid/span/5"
            itemHeight="300"
            preFetchLine="2"
            paddingBottom="20"
            wireframe="false"/>
</brls:Box>
