<brls:Box
        axis="column"
        width="100%"
        height="100%"
        paddingLeft="32"
        paddingRight="28"
        paddingTop="24"
        backgroundColor="@theme/color/nx_background">

    <brls:Box
            width="100%"
            height="92"
            alignItems="center">
        <brls:Box axis="column" grow="1">
            <brls:Label
                    text="FİLMLER"
                    fontSize="30"
                    textColor="@theme/brls/text" />
            <brls:Label
                    text="Arşivinden seç, izle veya Switch'e indir"
                    marginTop="6"
                    fontSize="15"
                    textColor="@theme/font/grey" />
        </brls:Box>

        <brls:Box
                height="40"
                paddingLeft="14"
                paddingRight="14"
                backgroundColor="@theme/color/nx_surface"
                cornerRadius="20"
                alignItems="center">
            <brls:Label
                    id="nx/vod/status"
                    text="Film arşivi yükleniyor…"
                    fontSize="13"
                    textColor="@theme/font/grey" />
        </brls:Box>
    </brls:Box>

    <brls:Box
            width="100%"
            height="34"
            marginBottom="8"
            alignItems="center">
        <brls:Label text="A  Oynat" fontSize="13" textColor="@theme/font/grey" />
        <brls:Label text="R  İndir" marginLeft="22" fontSize="13" textColor="@theme/color/nx_accent" />
        <brls:Label text="Y  Yenile" marginLeft="22" fontSize="13" textColor="@theme/font/grey" />
    </brls:Box>

    <RecyclingGrid
            id="nx/vod/grid"
            grow="1"
            width="100%"
            spanCount="@style/tsvitch/grid/span/5"
            itemHeight="315"
            preFetchLine="2"
            paddingBottom="20"
            wireframe="false" />
</brls:Box>
