<brls:Box
        wireframe="false"
        highlightCornerRadius="14"
        axis="column"
        width="auto"
        height="auto"
        padding="6">

    <brls:Box
            width="100%"
            height="79%"
            backgroundColor="@theme/color/nx_surface"
            cornerRadius="12">
        <brls:Image
                id="nx/card/picture"
                scalingType="fill"
                width="100%"
                height="100%"
                cornerRadius="12" />

        <brls:Box
                positionType="absolute"
                positionLeft="10"
                positionBottom="10"
                height="25"
                paddingLeft="9"
                paddingRight="9"
                backgroundColor="@theme/color/nx_badge"
                cornerRadius="12"
                alignItems="center">
            <brls:Label
                    text="NX MEDIA"
                    fontSize="11"
                    textColor="#ffffff" />
        </brls:Box>
    </brls:Box>

    <brls:Label
            id="nx/card/title"
            marginTop="9"
            width="100%"
            height="26"
            fontSize="18"
            textColor="@theme/brls/text"
            singleLine="true" />

    <brls:Label
            id="nx/card/meta"
            width="100%"
            height="20"
            fontSize="13"
            textColor="@theme/font/grey"
            singleLine="true" />
</brls:Box>
