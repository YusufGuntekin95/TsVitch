<brls:AppletFrame
        iconInterpolation="linear"
        headerHidden="true"
        footerHidden="false">
    <brls:Box
            axis="column"
            width="100%"
            height="100%"
            backgroundColor="@theme/color/nx_background">

        <brls:Box
                width="100%"
                height="68"
                paddingLeft="34"
                paddingRight="26"
                alignItems="center"
                backgroundColor="@theme/color/nx_sidebar">
            <brls:Label
                    text="NX"
                    fontSize="28"
                    textColor="@theme/color/nx_accent"/>
            <brls:Label
                    text="MEDIA"
                    marginLeft="7"
                    fontSize="24"
                    textColor="#ffffff"/>
            <brls:Label
                    text="Switch için premium medya merkezi"
                    marginLeft="22"
                    fontSize="13"
                    textColor="@theme/font/grey"/>
        </brls:Box>

        <AutoTabFrame
                id="main/tabFrame"
                grow="1"
                tabBackgroundColor="@theme/color/nx_sidebar"
                tabItemActiveTextColor="@theme/color/nx_accent"
                disableNavigationDown="true"
                defaultTab="0"
                sidebarPosition="top">

            <Tab label="Canlı TV"
                 fontSize="15"
                 icon="@res/svg/ico-home.svg"
                 iconActivate="@res/svg/ico-home-activate.svg">
                <HomeLive/>
            </Tab>

            <Tab label="Filmler"
                 fontSize="15"
                 icon="@res/svg/ico-movies.svg"
                 iconActivate="@res/svg/ico-movies-activate.svg">
                <HomeVod/>
            </Tab>

            <Tab label="Diziler"
                 fontSize="15"
                 icon="@res/svg/ico-series.svg"
                 iconActivate="@res/svg/ico-series-activate.svg">
                <HomeSeries/>
            </Tab>

            <Tab label="İndirilenler"
                 fontSize="15"
                 icon="@res/svg/ico-downloads.svg"
                 iconActivate="@res/svg/ico-downloads-activate.svg">
                <HomeDownloads/>
            </Tab>

            <Tab label="Favoriler"
                 fontSize="15"
                 icon="@res/svg/ico-favorites.svg"
                 iconActivate="@res/svg/ico-favorites-activate.svg">
                <HomeFavorites/>
            </Tab>
        </AutoTabFrame>

        <brls:Box
                wireframe="false"
                width="58"
                height="58"
                axis="column"
                justifyContent="center"
                alignItems="center"
                positionType="absolute"
                positionRight="16"
                positionTop="5">
            <CustomButton
                    id="main/setting"
                    focusable="true"
                    highlightCornerRadius="26"
                    cornerRadius="26"
                    width="52"
                    height="52"
                    wireframe="false"
                    backgroundColor="@theme/color/nx_surface">
                <SVGImage
                        width="34"
                        height="34"
                        SVG="@res/svg/ico-setting.svg"/>
            </CustomButton>
        </brls:Box>
    </brls:Box>
</brls:AppletFrame>
